# Copy to backend/.env and fill in what you need. Every value is optional for the demo:
# with no configuration PowerChat runs in mock mode and never contacts WhatsApp or MPM.
# Secrets live only here (server side). Never commit backend/.env.

# --- Database ----------------------------------------------------------------
# Default: SQLite file backend/powerchat.db (development). Production: MySQL, the engine MPM already runs.
# DATABASE_URL=mysql+pymysql://powerchat:password@db-host:3306/powerchat
# The schema is created/upgraded automatically at startup (Alembic migrations in backend/migrations).

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_TICK_SECONDS=3
RUN_SCHEDULER=true
SEED_ON_STARTUP=true            # demo data; set false in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- WhatsApp Business Cloud API ---------------------------------------------
# mock  = messages are simulated and never leave PowerChat (default)
# cloud = real messages, but ONLY if WHATSAPP_LIVE_SEND_ENABLED=true, and only to consenting MPM customers
#         on WHATSAPP_ALLOWED_RECIPIENTS (unless WHATSAPP_ALLOWLIST_DISABLED=true). Demo customers are never sent.
WHATSAPP_MODE=mock
WHATSAPP_LIVE_SEND_ENABLED=false
WHATSAPP_ALLOWED_RECIPIENTS=            # comma-separated E.164 numbers, e.g. +250788123456,+250788654321
WHATSAPP_ALLOWLIST_DISABLED=false
WHATSAPP_ACCESS_TOKEN=                  # system-user access token (Meta Business Settings)
WHATSAPP_PHONE_NUMBER_ID=               # from WhatsApp Manager > API setup
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=                  # any random string; enter the same value in the Meta webhook settings
META_APP_SECRET=                        # App settings > Basic > App secret (verifies X-Hub-Signature-256)
WHATSAPP_API_VERSION=v26.0              # current Graph API version (released 29 July 2026)
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- MicroPowerManager -------------------------------------------------------
# A dedicated MPM user (service account) used to read customers through MPM's REST API (JWT login).
MPM_BASE_URL=                           # e.g. https://mpm.example.org (MPM backend, without /api)
MPM_EMAIL=
MPM_PASSWORD=
MPM_DEFAULT_COUNTRY_CODE=250            # converts local numbers such as 0788... to +250788...
MPM_SMS_ENABLED=false                   # deliver SMS-preference customers through MPM's /api/sms/storeandsend
MPM_SYNC_INTERVAL_MINUTES=0             # 0 = manual sync from Settings > Integrations

# --- Meter telemetry ---------------------------------------------------------
TELEMETRY_API_KEY=                      # enables POST /api/telemetry/readings (header X-PowerChat-Key)
