# Copy to backend/.env and adjust. All values are optional for the demo.
# Secrets belong here (server side), never in frontend code.

# Database: SQLite by default. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/powerchat
# DATABASE_URL=sqlite:///./powerchat.db   (default: backend/powerchat.db)

# Scheduler / simulation
SCHEDULER_TICK_SECONDS=3
RUN_SCHEDULER=true
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp Business Cloud API (future). NOT used by the prototype: all messages are simulated.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# MicroPowerManager REST API (future). NOT connected in the prototype.
MPM_BASE_URL=
MPM_API_TOKEN=
